# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# --- Obrigatórias ----------------------------------------------------------
# Chave do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# JSON da service account do Google (caminho absoluto ou relativo ao projeto)
GOOGLE_CREDENTIALS=credenciais/service_account.json
# ID da planilha: o trecho entre /d/ e /edit na URL do Google Sheets
PLANILHA_ID=
# Token do bot, criado com o @BotFather no Telegram
TELEGRAM_TOKEN=
# Seu ID numérico no Telegram (aparece no terminal na primeira mensagem). Vários: 123,456
TELEGRAM_ALLOWED_IDS=

# --- LinkedIn (só para publicar) -------------------------------------------
# App em https://www.linkedin.com/developers/apps com o produto "Share on LinkedIn"
# e o redirect http://localhost:8765/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Versão da API (AAAAMM). Vazio = dois meses atrás, calculado sozinho.
LINKEDIN_VERSION=

# --- Opcionais -------------------------------------------------------------
# Como o Ultron chama você
ULTRON_USUARIO=Arthur
# Fuso horário usado para "hoje" e "ontem"
ULTRON_FUSO=America/Sao_Paulo
# Lembrete diário quando nada foi registrado no dia: HH:MM ou off
ULTRON_LEMBRETE=21:00
# Respostas em áudio e legenda nos áudios: on/off
ULTRON_VOZ=on
ULTRON_LEGENDA=on
# Voz pronta do Gemini TTS
ULTRON_VOZ_NOME=Charon

# Modelos do Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_RESERVA=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
